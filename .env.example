APP_HOST=0.0.0.0
APP_PORT=8000

# Logging
LOG_LEVEL=INFO

# CLINE CLI configuration
CLINE_CLI_BIN=cline
CLINE_CLI_ARGS=[]
DEFAULT_BASE_BRANCH=main
TASK_WORKDIR=/path/to/tasks/workdir

# Jira configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_VERIFY_SSL=true

# Frontend origins allowed by CORS (Next.js dev server)
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000", "https://stirred-organic-spaniel.ngrok-free.app"]


# --- LLM / OpenRouter ---
OPENROUTER_API_KEY="sk-or-v1-"
